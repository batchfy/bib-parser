{
  "name": "@batchfy/bib-parser",
  "version": "1.0.0",
  "description": "A fully-typed TypeScript BibTeX parser and serializer, ported from ORCID/bibtexParseJs",
  "license": "MIT",
  "author": "Batchfy LLC <batchfy@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "bibtex",
    "parser",
    "typescript",
    "bibliography",
    "latex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
